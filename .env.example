POORTOPOUR_ENVIRONMENT=local
POORTOPOUR_PROVIDER=mock
POORTOPOUR_ALPHA_VANTAGE_API_KEY=
POORTOPOUR_ALPHA_VANTAGE_DAILY_FUNCTION=TIME_SERIES_DAILY
POORTOPOUR_SCANNER_RISK_REWARD_ATR_BUFFER_MULTIPLIER=0.5
POORTOPOUR_SCANNER_RISK_REWARD_TARGET_MULTIPLE=2.0
POORTOPOUR_ALLOW_HOSTED_MANUAL_SCAN=false
POORTOPOUR_HOSTED_MANUAL_SCAN_MAX_SYMBOLS=25
POORTOPOUR_API_PORT=8000
POORTOPOUR_FRONTEND_PORT=5173
POORTOPOUR_DATABASE_URL=postgresql+psycopg://poortopour:poortopour@db:5432/poortopour
POSTGRES_DB=poortopour
POSTGRES_USER=poortopour
POSTGRES_PASSWORD=poortopour
