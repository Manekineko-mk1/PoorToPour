POORTOPOUR_ENVIRONMENT=local
POORTOPOUR_PROVIDER=mock
POORTOPOUR_ALPHA_VANTAGE_API_KEY=
POORTOPOUR_ALPHA_VANTAGE_DAILY_FUNCTION=TIME_SERIES_DAILY
POORTOPOUR_SCANNER_RISK_REWARD_ATR_BUFFER_MULTIPLIER=0.5
POORTOPOUR_SCANNER_RISK_REWARD_TARGET_MULTIPLE=2.0
POORTOPOUR_ALLOW_HOSTED_MANUAL_SCAN=false
POORTOPOUR_HOSTED_MANUAL_SCAN_MAX_SYMBOLS=25
POORTOPOUR_MANUAL_SCAN_API_KEY=
POORTOPOUR_MANUAL_SCAN_RATE_LIMIT=5
# Minimum fraction (0.0-1.0) of symbols that must refresh before a manual scan runs.
# 0.0 = lenient (partial refresh proceeds with a warning); 1.0 = require every symbol.
POORTOPOUR_MANUAL_SCAN_MIN_REFRESH_RATIO=0.0
POORTOPOUR_SCHEDULED_SCAN_ENABLED=true
POORTOPOUR_SCHEDULED_SCAN_TIME=06:00
POORTOPOUR_SCHEDULED_SCAN_TIMEZONE=America/New_York
POORTOPOUR_SCHEDULED_SCAN_REFRESH_PERIOD=1y
# Leave blank to scan the full persisted universe.
POORTOPOUR_SCHEDULED_SCAN_MAX_SYMBOLS=
POORTOPOUR_SCHEDULED_SCAN_STARTUP_CATCHUP=true
POORTOPOUR_API_PORT=8000
POORTOPOUR_FRONTEND_PORT=5173
POORTOPOUR_DATABASE_URL=postgresql+psycopg://poortopour:poortopour@db:5432/poortopour
POSTGRES_DB=poortopour
POSTGRES_USER=poortopour
POSTGRES_PASSWORD=poortopour
